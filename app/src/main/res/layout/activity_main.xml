<?xml version="1.0" encoding="utf-8"?>
<!--ViewGroup1 (Caja principal)-->
<LinearLayout
    android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!--TextView widget dentro del ViewGroup1-->
    <TextView
        android:id="@+id/mainTextViewActivity1"
        style="@style/TextAppearance.MaterialComponents.Headline6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_gravity="center_horizontal"
        android:text="Enter any word you want" />

    <!--Aqui creo el contenedor con bordes redondeados que envuelve el ViewGroup2-->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@android:color/white">

        <!--ViewGroup2 Es como una caja dentro de otra caja que ademas esta dentro de la caja principal llamada LinearLayout -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:clipToPadding="false">

            <EditText
                android:id="@+id/textInput1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter text"
                android:inputType="text" />

            <Button
                android:id="@+id/buttonSubmit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/textInput1"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="12dp"
                android:text="Submit" />

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>